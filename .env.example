# ==============================================================================
# Telegram Bot Configuration
# ==============================================================================
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
SUPER_ADMINS=123456789,987654321
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - [%(levelname)s] - %(name)s - %(message)s

# ==============================================================================
# PostgreSQL Database (Docker & Local)
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=fairqueue_db
POSTGRES_PORT=5432

# URL подключения для локального запуска без Docker Compose:
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password@localhost:5432/fairqueue_db

# ==============================================================================
# YooKassa Payments (Опционально)
# ==============================================================================
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
# YOOKASSA_RETURN_URL=https://t.me/FairLabQueueBot

# ==============================================================================
# Docker Deployment (Опционально для Production)
# ==============================================================================
DOCKER_USERNAME=fairlab
