# Скопируйте в .env и заполните.
BOT_TOKEN=
SUPER_ADMINS=123456789
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s %(levelname)s %(name)s: %(message)s

# PostgreSQL (рекомендуется в продакшене)
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@127.0.0.1:5432/fairlab_queue

# Без DATABASE_URL бот использует SQLite (src/app.db).
